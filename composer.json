{
    "name": "gizmocraft/zendframework1-view-helper-navigation",
    "description": "Zend Framework 1 View_Helper_Navigation component",
    "type": "library",
    "keywords": [
        "framework",
        "zf1"
    ],
    "homepage": "http://framework.zend.com/",
    "license": "BSD-3-Clause",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "gizmocraft/zendframework1-acl": "^2.0.0",
        "gizmocraft/zendframework1-config": "^3.0.0",
        "gizmocraft/zendframework1-loader": "^2.0.0",
        "gizmocraft/zendframework1-navigation": "^2.0.0",
        "gizmocraft/zendframework1-registry": "^2.0.0",
        "gizmocraft/zendframework1-translate": "^2.0.0",
        "gizmocraft/zendframework1-uri": "^2.0.0",
        "gizmocraft/zendframework1-validate-sitemap": "^2.0.0",
        "gizmocraft/zendframework1-view": "^2.0.0",
        "gizmocraft/zendframework1-view-helper-url": "^2.0.0",
        "gizmocraft/zendframework1-view-helper-partial": "^2.0.0"
    },
    "autoload": {
        "psr-0": {
            "Zend_View_Helper_Navigation_": "src/"
        },
        "classmap": [
            "src/Zend/View/Helper/Navigation.php"
        ]
    },
    "autoload-dev": {
        "psr-0": {
            "Zend_": "tests/"
        }
    },
    "include-path": [
        "src/"
    ],
    "require-dev": {
        "gizmocraft/zendframework1-xml": "^2.0.0",
        "phpunit/phpunit": "^13.4.8",
        "phpstan/phpstan": "^2.3.7",
        "friendsofphp/php-cs-fixer": "^3.95.32",
        "phpro/grumphp-shim": "^2.27.2"
    },
    "archive": {
        "exclude": [
            "/tests"
        ]
    },
    "scripts": {
        "test": "phpunit ./tests",
        "test-with-coverage": "phpunit --coverage-clover=clover.xml",
        "phpstan": "phpstan analyze -c phpstan.neon --no-progress --ansi --memory-limit=768M",
        "style-check": "php-cs-fixer fix --dry-run -vv"
    },
    "suggest": {
        "ext-dom": "Used in the Navigation_Sitemap helper"
    },
    "config": {
        "allow-plugins": {
            "phpro/grumphp-shim": true
        }
    }
}
